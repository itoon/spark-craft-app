  "jsCodeByPage": {
    "page1": "var toolbar1 = new Toolbar('page1_toolbar1');\npage.add(toolbar1);\n\nvar spinner1 = new Spinner('page1_spinner1');\npage.add(spinner1);\nspinner1.hide()\n\nvar camera3 = new Camera('page1_camera3');\npage.add(camera3);\n\nvar button2 = new Button('page1_button2');\npage.add(button2);\n\nvar button4 = new Button('page1_button4');\npage.add(button4);\n\nvar button5 = new Button('page1_button5');\npage.add(button5);\n\nvar button6 = new Button('page1_button6');\npage.add(button6);\n\nlet photo\n\nbutton2.onClick(async() =>{\n  photo = await camera3.capture()  \n})\n\nbutton6.onClick(() => {\n  const filter = ['warn','cool', 'grayscale']  \n  camera3.setFilter(filter[Math.floor(Math.random()*filter.length)])\n})\n\nbutton5.onClick(function(){\n  camera3.reset()\n})\n\nbutton4.onClick(async() =>{\n  await photo.save('my-photo.png')\n})\n\n",
    "page2": "// --- Connect elements to the page ---\n\nvar toolbar2 = new Toolbar('page2_toolbar2');\npage.add(toolbar2)\ntoolbar2.backButton.onClick(() => {\n  page.goTo('page1');\n});"
  },
