    "page1": "var label1 = new Label('page1_label1');\npage.add(label1);\n\nvar labelledinput1 = new LabelledInput('page1_labelledinput1');\npage.add(labelledinput1);\n\nvar input1 = new Input('page1_input1');\npage.add(input1);\n\n// --- Connect elements to the page ---\n\nvar toolbar1 = new Toolbar('page1_toolbar1');\npage.add(toolbar1);\n\nvar button1 = new Button('page1_button1');\npage.add(button1);\n\n// --- Add interactions ---\nbutton1.onClick(() => {\n    console.log(labelledinput1.value)\n    console.log(input1.value)\n    label1.content = parseInt(labelledinput1.value)+parseInt(input1.value)    \n});\n"
